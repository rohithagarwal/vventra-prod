# Server Settings
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security & Auth
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
ACCESS_TOKEN_MINUTES=60
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Database (Neon PostgreSQL Serverless)
# Note: Use unpooled or pooled URL without ?sslmode=require (SSL is handled natively by asyncpg)
POSTGRES_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-quiet-field-a11t41oy.ap-southeast-1.aws.neon.tech/neondb

# Redis (Optional in local, required for production rate-limiting)
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins (Frontend domains)
CORS_ORIGINS=["http://localhost:3000","https://vventra-prod.vercel.app"]

# Optional OAuth & Payments
GOOGLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
